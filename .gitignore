/*
!/.editorconfig
!/.gitattributes
!/.gitignore
!/NOTICE.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradlew
!/gradlew.bat
!/gradle/
!/src/
!/config/
!/docs/

# Only templates belong in version control.
/config/*
!/config/*.example.properties
!/config/*.example.json

# Keep the wrapper, not local Gradle configuration or caches.
/gradle/*
!/gradle/wrapper/
/gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# Local tools and operating-system files can appear inside source directories.
.gradle/
.idea/
.vscode/
.run/
.DS_Store
._*
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
*.iml

# Build products, archives, logs, and partial downloads are never source assets.
/build/
/out/
/bin/
*.class
*.jar
*.war
*.zip
*.7z
*.tar
*.tar.gz
*.log
*.tmp
*.temp
*.part
*.bak
*.backup
*.orig
*.rej
*.hprof
hs_err_pid*
replay_pid*
!/gradle/wrapper/gradle-wrapper.jar

# Runtime state and credentials stay local, even if copied under src/.
/data/
/mirror/
.env
.env.*
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.pem
*.key
*.der
*.p12
*.pfx
*.jks
*.keystore
